{
  "format": "precious-recipe",
  "version": 1,
  "source": {
    "name": "Discogs",
    "description": "Records and CDs from Discogs, and what copies sell for. Search by title or scan the barcode. Needs a free personal access token: discogs.com → Settings → Developers → Generate new token, then set it as token.",
    "baseUrl": "https://api.discogs.com",
    "auth": {
      "type": "none"
    },
    "headers": [
      {
        "name": "Authorization",
        "value": "Discogs token={{ secrets.token }}"
      }
    ],
    "rateLimit": {
      "requests": 1,
      "perSeconds": 1
    },
    "cacheSeconds": 604800
  },
  "secretNames": ["token"],
  "endpoints": [
    {
      "key": "search",
      "name": "Search releases",
      "role": "search",
      "kind": "rest",
      "method": "GET",
      "path": "/database/search",
      "query": [
        {
          "name": "q",
          "value": "{{ query }}"
        },
        {
          "name": "type",
          "value": "release"
        },
        {
          "name": "per_page",
          "value": "25"
        }
      ],
      "map": {
        "results": "results",
        "id": "id",
        "title": "$contains(title, ' - ') ? $substringAfter(title, ' - ') : title",
        "subtitle": "$join([format[0], country, catno], ' · ')",
        "year": "year ? $number(year)",
        "image": "cover_image ? cover_image",
        "artist": "$contains(title, ' - ') ? $substringBefore(title, ' - ')"
      },
      "sample": {
        "query": "random access memories"
      }
    },
    {
      "key": "release",
      "name": "Release details",
      "role": "lookup",
      "kind": "rest",
      "method": "GET",
      "path": "/releases/{{ refs.discogs }}",
      "map": {
        "artist": "$join(artists.$replace(name, / \\(\\d+\\)$/, ''), ', ')",
        "label": "$replace(labels[0].name, / \\(\\d+\\)$/, '')",
        "catalogue_no": "labels[0].catno",
        "year": "year ? year",
        "country": "country",
        "format": "( $f := formats[0]; $d := $f.descriptions; $f.name = 'Box Set' or 'Box Set' in $d ? 'Box set' : '7\"' in $d ? '7\"' : '10\"' in $d ? '10\"' : 'EP' in $d ? 'EP' : 'LP' in $d ? ($number($f.qty) > 1 ? $f.qty & '×LP' : 'LP') : $f.name )",
        "genre": "genres",
        "style": "styles",
        "weight_g": "estimated_weight",
        "tracklist": "$join(tracklist[type_ = 'track'].(position & '  ' & title), '\\n')",
        "image": "$append(images[type = 'primary'], images)[0].uri"
      },
      "sample": {
        "refs": {
          "discogs": "4570366"
        }
      }
    },
    {
      "key": "lowest_price",
      "name": "Lowest price for sale",
      "role": "compute",
      "kind": "rest",
      "method": "GET",
      "path": "/marketplace/stats/{{ refs.discogs }}",
      "query": [
        {
          "name": "curr_abbr",
          "value": "EUR"
        }
      ],
      "map": {
        "value": "lowest_price.value"
      },
      "cacheSeconds": 86400,
      "sample": {
        "refs": {
          "discogs": "4570366"
        }
      }
    },
    {
      "key": "suggested_price",
      "name": "Suggested price, VG+ (needs seller settings)",
      "role": "compute",
      "kind": "rest",
      "method": "GET",
      "path": "/marketplace/price_suggestions/{{ refs.discogs }}",
      "map": {
        "value": "$lookup($, 'Very Good Plus (VG+)').value ~> $round(2)"
      },
      "cacheSeconds": 86400,
      "sample": {
        "refs": {
          "discogs": "4570366"
        }
      }
    }
  ]
}
