#!/command/with-contenv bash
# The bundled PostgreSQL, reachable only from inside the container.
if [ "$(cat /run/precious-db)" != bundled ]; then exec sleep infinity; fi
exec s6-setuidgid precious postgres -D /data/postgres \
  -c listen_addresses=127.0.0.1 \
  -c unix_socket_directories=/run/postgresql \
  -c logging_collector=off \
  -c log_min_messages=warning
